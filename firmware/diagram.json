{
  "version": 1,
  "author": "Wokwi",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-mpu6050",
      "id": "imu",
      "top": 0,
      "left": 200,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "led-green",
      "top": 120,
      "left": 300,
      "attrs": { "color": "green" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r-green",
      "top": 150,
      "left": 300,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led-yellow",
      "top": 220,
      "left": 300,
      "attrs": { "color": "yellow" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r-yellow",
      "top": 250,
      "left": 300,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
      "id": "led-red",
      "top": 320,
      "left": 300,
      "attrs": { "color": "red" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r-red",
      "top": 350,
      "left": 300,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": 220,
      "left": 400,
      "attrs": { "mode": "smooth" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "imu:VCC", "esp:3V3", "red", [] ],
    [ "imu:GND", "esp:GND.1", "black", [] ],
    [ "imu:SDA", "esp:21", "green", [] ],
    [ "imu:SCL", "esp:22", "blue", [] ],
    [ "esp:25", "r-green:1", "", [] ],
    [ "r-green:2", "led-green:A", "", [] ],
    [ "led-green:C", "esp:GND.1", "", [] ],
    [ "esp:26", "r-yellow:1", "", [] ],
    [ "r-yellow:2", "led-yellow:A", "", [] ],
    [ "led-yellow:C", "esp:GND.1", "", [] ],
    [ "esp:27", "r-red:1", "", [] ],
    [ "r-red:2", "led-red:A", "", [] ],
    [ "led-red:C", "esp:GND.1", "", [] ],
    [ "buzzer:1", "esp:GND.1", "black", [] ],
    [ "buzzer:2", "esp:32", "red", [] ]
  ],
  "serialMonitor": {
    "display": "always",
    "newline": "lf"
  }
}
