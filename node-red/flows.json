    {
        "id": "validate1",
        "type": "function",
        "z": "flow1",
        "name": "Validate contract",
        "func": "const deviceId = \"esp32-01\";\nconst telemetryTopic = `fragile-freight/${deviceId}/telemetry`;\nconst alertTopic = `fragile-freight/${deviceId}/alert`;\nif (msg.retain === true) return null;\nconst d = msg.payload;\nconst exactKeys = (v, keys) => v !== null && typeof v === \"object\" && !Array.isArray(v) && Object.keys(v).length === keys.length && keys.every(k => Object.prototype.hasOwnProperty.call(v, k));\nconst finite = v => typeof v === \"number\" && Number.isFinite(v);\nif (msg.topic === telemetryTopic) {\n    if (!exactKeys(d, [\"deviceId\", \"ax\", \"ay\", \"az\", \"gForce\", \"status\"]) || d.deviceId !== deviceId || ![d.ax, d.ay, d.az, d.gForce].every(finite) || ![\"SAFE\", \"WARNING\", \"DANGER\"].includes(d.status)) return null;\n} else if (msg.topic === alertTopic) {\n    if (!exactKeys(d, [\"deviceId\", \"status\", \"gForce\"]) || d.deviceId !== deviceId || d.status !== \"DANGER\" || !finite(d.gForce)) return null;\n    const now = Date.now(), last = context.get(\"lastAlert\");\n    if (last !== undefined && now - last < 1000) return null;\n    context.set(\"lastAlert\", now);\n} else return null;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 300,
        "y": 120,
        "wires": [
            [
                "sw1"
            ]
        ]
    },
