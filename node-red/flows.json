    {
        "id": "eb9411b45aa7183e",
        "type": "function",
        "z": "flow1",
        "name": "Format DANGER",
        "func": "const CHAT_ID = env.get(\"TELEGRAM_CHAT_ID\");\nconst d = msg.payload;\nif (!d || d.deviceId !== \"esp32-01\" || d.status !== \"DANGER\" || typeof d.gForce !== \"number\" || !Number.isFinite(d.gForce) || !CHAT_ID) return null;\nconst text = \"CẢNH BÁO VA ĐẬP (DANGER)\\n\" + \"Thiết bị: \" + d.deviceId + \"\\n\" + \"G-force: \" + d.gForce + \" g\";\nmsg.payload = { chatId: CHAT_ID, type: \"message\", content: text };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
