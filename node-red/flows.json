  {
    "id": "ff-dashboard",
    "type": "ui_template",
    "z": "ff-tab",
    "group": "ff-ui-group",
    "name": "Live status and remote buzzer controls",
    "order": 1,
    "width": "12",
    "height": "5",
    "format": "<div ng-if=\"msg.payload\" style=\"padding:12px\"><h2>Shipment {{msg.payload.deviceId}} <span style=\"float:right\">{{msg.payload.status}}</span></h2><h1>{{msg.payload.gForce | number:2}} g</h1><p>Ax {{msg.payload.ax | number:2}}g · Ay {{msg.payload.ay | number:2}}g · Az {{msg.payload.az | number:2}}g</p><p>Updated {{msg.payload.receivedAt}}</p><md-button class=\"md-raised md-primary\" ng-click=\"send({payload:'ALARM_ON'})\">Enable local buzzer</md-button><md-button class=\"md-raised\" ng-click=\"send({payload:'ALARM_OFF'})\">Disable local buzzer</md-button><p>Alarm control affects only future local buzzer tones. Remote alerts remain enabled.</p></div>",
    "storeOutMessages": true,
    "fwdInMessages": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 700,
    "y": 100,
    "wires": [["ff-command"]]
  },
  {
    "id": "ff-chart",
    "type": "ui_chart",
    "z": "ff-tab",
    "name": "G-force history",
    "group": "ff-ui-group",
    "order": 2,
    "width": "12",
    "height": "6",
    "label": "G-force (g)",
    "chartType": "line",
    "legend": "false",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "Waiting for telemetry",
    "dot": false,
    "ymin": "0",
    "ymax": "",
    "removeOlder": "1",
    "removeOlderPoints": "120",
    "removeOlderUnit": "3600",
    "cutout": 0,
    "useOneColor": false,
    "useUTC": false,
    "colors": ["#1f77b4", "#aec7e8", "#ff7f0e", "#2ca02c", "#98df8a", "#d62728", "#ff9896", "#9467bd", "#c5b0d5"],
    "outputs": 1,
    "useDifferentColor": false,
    "className": "",
    "x": 690,
    "y": 160,
    "wires": [[]]
  },
  {
    "id": "ff-command",
    "type": "function",
    "z": "ff-tab",
    "name": "Build device command",
    "func": "if (msg.payload !== 'ALARM_ON' && msg.payload !== 'ALARM_OFF') return null; msg.topic='fragile-freight/esp32-01/command'; return msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 970,
    "y": 100,
    "wires": [["ff-out-command"]]
  },
  {
    "id": "ff-out-command",
    "type": "mqtt out",
    "z": "ff-tab",
    "name": "ESP32 command downlink",
    "topic": "",
    "qos": "0",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "ff-local-broker",
