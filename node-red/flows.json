    {
        "id": "eb9411b45aa7183e",
        "type": "function",
        "z": "flow1",
        "name": "Format DANGER",
        "func": "const COOLDOWN_MS = 30000;      // chờ 30 giây giữa hai lần gửi\nconst CHAT_ID = 8845662574;     // chat ID Telegram\n\nconst d = msg.payload;\nif (!d || d.status !== \"DANGER\") {\n    return null;\n}\n\nconst now = Date.now();\nconst last = context.get(\"lastSent\") || 0;\nif (now - last < COOLDOWN_MS) {\n    return null;\n}\ncontext.set(\"lastSent\", now);\n\nconst text = \"CẢNH BÁO VA ĐẬP (DANGER)\\n\" +\n    \"Thiết bị: \" + d.deviceId + \"\\n\" +\n    \"G-force: \" + d.gForce + \" g\\n\" +\n    \"Thời gian: \" + new Date().toLocaleString(\"vi-VN\", { timeZone: \"Asia/Ho_Chi_Minh\" });\n\nmsg.payload = { chatId: CHAT_ID, type: \"message\", content: text };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
