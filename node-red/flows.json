    "disabled": false,
    "hidden": false
  },
  {
    "id": "ff-ui-group",
    "type": "ui_group",
    "name": "Live shipment monitor",
    "tab": "ff-ui-tab",
    "order": 1,
    "disp": true,
    "width": "12",
    "collapse": false
  },
  {
    "id": "ff-in-telemetry",
    "type": "mqtt in",
    "z": "ff-tab",
    "name": "ESP32 telemetry",
    "topic": "fragile-freight/esp32-01/telemetry",
    "qos": "0",
    "datatype": "auto-detect",
    "broker": "ff-local-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 150,
    "y": 120,
    "wires": [["ff-validate"]]
  },
  {
    "id": "ff-validate",
    "type": "function",
    "z": "ff-tab",
    "name": "Validate, classify and route",
    "func": "let p = msg.payload;\ntry { if (typeof p === 'string') p = JSON.parse(p); } catch (e) { return [null, null, null, null, {payload: 'Malformed telemetry JSON: ' + String(msg.payload)}, null]; }\nconst finite = v => typeof v === 'number' && Number.isFinite(v);\nif (!p || p.deviceId !== 'esp32-01' || !finite(p.ax) || !finite(p.ay) || !finite(p.az) || !finite(p.gForce) || !['SAFE','WARNING','DANGER'].includes(p.status)) return [null, null, null, null, {payload: 'Invalid telemetry fields: ' + JSON.stringify(p)}, null];\nconst d = Math.abs(p.gForce - 1);\nconst expected = d >= 0.9 ? 'DANGER' : d >= 0.4 ? 'WARNING' : 'SAFE';\nconst view = {deviceId:p.deviceId, status:p.status, gForce:p.gForce, ax:p.ax, ay:p.ay, az:p.az, receivedAt:new Date().toLocaleString()};\nconst dashboard = {payload:view};\nconst chart = {topic:p.deviceId, payload:p.gForce};\nconst warning = p.status === 'WARNING' ? {payload:'WARNING: impact deviation ' + d.toFixed(2) + 'g (' + p.gForce.toFixed(2) + 'g magnitude).'} : null;\nconst abnormal = p.status !== expected ? {payload:'ABNORMAL TELEMETRY: reported=' + p.status + ', expected=' + expected + ', gForce=' + p.gForce.toFixed(2) + 'g.'} : null;\nreturn [dashboard, chart, warning, abnormal, null, {payload:p}];",
    "outputs": 6,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 120,
    "wires": [["ff-dashboard"], ["ff-chart"], ["ff-telegram-body"], ["ff-telegram-body"], ["ff-telegram-body"], ["ff-aio-values"]]
  },
  {
    "id": "ff-in-alert",
    "type": "mqtt in",
    "z": "ff-tab",
    "name": "ESP32 DANGER events",
    "topic": "fragile-freight/esp32-01/alert",
    "qos": "0",
    "datatype": "auto-detect",
    "broker": "ff-local-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 160,
    "y": 220,
    "wires": [["ff-alert-text"]]
  },
  {
    "id": "ff-alert-text",
    "type": "function",
    "z": "ff-tab",
    "name": "Format DANGER alert",
    "func": "let p=msg.payload; try { if (typeof p==='string') p=JSON.parse(p); } catch(e) { return {payload:'Malformed DANGER alert received.'}; } if (!p || p.deviceId!=='esp32-01' || p.status!=='DANGER' || typeof p.gForce!=='number' || !Number.isFinite(p.gForce)) return {payload:'Invalid DANGER alert: '+JSON.stringify(p)}; return {payload:'DANGER: shipment impact detected at '+p.gForce.toFixed(2)+'g. Check the fragile freight immediately.'};",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 220,
    "wires": [["ff-telegram-body"]]
  },
  {
    "id": "ff-telegram-body",
    "type": "function",
    "z": "ff-tab",
    "name": "Build Telegram request",
    "func": "const token=env.get('TELEGRAM_BOT_TOKEN'); const chat=env.get('TELEGRAM_CHAT_ID'); if (!token || !chat) { node.warn('Telegram skipped: set TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID'); return null; } msg.url='https://api.telegram.org/bot'+token+'/sendMessage'; msg.headers={'content-type':'application/json'}; msg.payload={chat_id:chat,text:String(msg.payload)}; return msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 660,
    "y": 240,
    "wires": [["ff-telegram-http"]]
  },
  {
    "id": "ff-telegram-http",
    "type": "http request",
    "z": "ff-tab",
    "name": "Telegram Bot API",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": true,
    "headers": [],
    "x": 900,
    "y": 240,
    "wires": [[]]
  },
  {
    "id": "ff-aio-values",
    "type": "function",
    "z": "ff-tab",
    "name": "Adafruit IO feed values",
    "func": "const p=msg.payload; return [{topic:'YOUR_AIO_USERNAME/feeds/fragile-gforce',payload:p.gForce},{topic:'YOUR_AIO_USERNAME/feeds/fragile-status',payload:p.status}];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 680,
    "y": 400,
    "wires": [["ff-aio-g"], ["ff-aio-status"]]
  },
  {
    "id": "ff-aio-g",
    "type": "mqtt out",
    "z": "ff-tab",
    "name": "AIO G-force feed",
    "topic": "",
    "qos": "0",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
